# Default-deny build context. Dockerfiles copy only the explicit source paths below.
**
!Cargo.toml
!Cargo.lock
!crates/
!crates/*/
!crates/*/Cargo.toml
!crates/*/src/
!crates/*/src/**
!migrations/
!migrations/*.sql
!web/
!web/package.json
!web/package-lock.json
!web/next.config.ts
!web/next-env.d.ts
!web/tsconfig.json
!web/postcss.config.mjs
!web/src/
!web/src/**
!web/public/
!web/public/**
!reference-web/
!reference-web/index.html
!reference-web/style.css
!reference-web/app.js
!reference-web/scene.js
!reference-web/wheel.js
!reference-web/platform.js
!reference-web/backend.mjs
!reference-web/backend.d.mts
!reference-web/public/
!reference-web/public/**
!deployment/
!deployment/*.Dockerfile
# Defense in depth, including files accidentally placed in an allowed directory.
**/.env*
**/*.pem
**/*.key
**/*.p12
**/*wallet*secret*
**/*envelope*
**/*.sqlite*
**/*.db
**/node_modules
**/.next
**/.git
**/.git/**
**/evidence
**/evaluations
**/artifacts
