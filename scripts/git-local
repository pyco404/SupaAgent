#!/usr/bin/env bash
# Use separate metadata; preserve the original read-only .git placeholder.
set -euo pipefail
project_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
arguments=("$@")
command_index=0
if [[ ${arguments[0]:-} == --literal-pathspecs ]]; then command_index=1; fi
command_name=${arguments[$command_index]:-}
if [[ $command_name == push ]]; then
    printf '%s\n' 'Push blocked: initial public push requires explicit user approval and a fresh secrets scan.' >&2
    exit 1
fi
for argument in "$@"; do
    if [[ $argument == --squash || $argument == --autosquash || $argument == --amend ]]; then
        printf '%s\n' 'History combining and amendment are disabled by the one-file commit workflow.' >&2
        exit 1
    fi
done
if [[ $command_name == add ]]; then
    file_arguments=("${arguments[@]:$((command_index+1))}")
    if [[ ${file_arguments[0]:-} == -- ]]; then file_arguments=("${file_arguments[@]:1}"); fi
    if [[ ${#file_arguments[@]} != 1 ]]; then
        printf '%s\n' 'Stage exactly one explicitly named file.' >&2
        exit 1
    fi
    file_path=${file_arguments[0]}
    if [[ $file_path == -* || $file_path == /* || $file_path == .. || $file_path == ../* || $file_path == */../* || ! -f $project_root/$file_path || -L $project_root/$file_path ]]; then
        printf '%s\n' 'Only one exact project-relative regular-file path may be staged.' >&2
        exit 1
    fi
    exec git --git-dir="$project_root/.git-recovery" --work-tree="$project_root" --literal-pathspecs add -- "$file_path"
fi
exec git --git-dir="$project_root/.git-recovery" --work-tree="$project_root" "$@"
