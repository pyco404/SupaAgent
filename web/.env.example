# Copy to .env.local only for a manually configured local operator console.
# scripts/web-local generates private credentials and connects the existing Devnet DB.
# These names are SERVER ONLY. Never add NEXT_PUBLIC_ to credentials.
SUPA_BACKEND_URL=http://127.0.0.1:8080
SUPA_API_TOKEN=replace-with-the-local-rust-api-token
SUPA_WEB_USERNAME=operator
SUPA_WEB_PASSWORD=replace-with-a-unique-password-at-least-24-characters
