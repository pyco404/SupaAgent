# The server reads exported variables. The live evaluator also loads private .env.eval.
# Explicit shell exports take precedence; .env.eval must have mode 0600.
DATABASE_URL=postgresql://supa:change-me@127.0.0.1:5432/supa_agent
SUPA_API_TOKEN=replace-with-at-least-32-random-characters
SUPA_BIND=127.0.0.1:8080
# offline is the safe default. No external calls or joke templates.
SUPA_PROVIDER=offline
# OpenAI requires BOTH SUPA_PROVIDER=openai and SUPA_ALLOW_OPENAI=true.
SUPA_ALLOW_OPENAI=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# No configurable remote endpoint: credentials only go to api.openai.com.
# Mandatory for live OpenAI: stable UUID retained across restarts, limit <= 1 USD.
SUPA_LIVE_BUDGET_ID=
SUPA_LIVE_BUDGET_MICROUSD=
# Optional conservative rate overrides; unset uses model rates verified 2026-10-27.
# Overrides below the verified baseline are rejected.
SUPA_INPUT_RATE_MICROUSD_PER_MILLION=
SUPA_CACHED_RATE_MICROUSD_PER_MILLION=
SUPA_OUTPUT_RATE_MICROUSD_PER_MILLION=
SUPA_MAX_OUTPUT_TOKENS=2048

SUPA_CACHE_WRITE_RATE_MICROUSD_PER_MILLION=
OPENAI_COMPLEX_MODEL=gpt-6.1-sol
SUPA_PLANNING_MODE=routine
# Dedicated localhost-only evaluator DB. --check never connects or sends paid requests.
SUPA_EVAL_DATABASE_URL=
# Paid evaluation ALSO requires explicit CLI --run --authorize-paid.

# Milestone 3: local Devnet observation only; disabled by default. No signing/broadcast.
SUPA_WALLET_ENABLED=false
SUPA_WALLET_OPERATOR_ID=
SUPA_WALLET_VAULT_DIR=
# Path to a separately protected 32-byte raw key file; never put the key itself here.
SUPA_WALLET_MASTER_FILE=
SUPA_SOLANA_RPC_URL=
# Optional observation poll interval >=30 seconds; unset means operator-triggered sync only.
# SUPA_WALLET_POLL_SECONDS=60
