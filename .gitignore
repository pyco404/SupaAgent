/target/
.env
.env.*
!.env.example
*.log
__pycache__/
# Generated evidence stays local; this does not untrack existing Git history.
/artifacts/

# Encrypted wallet envelopes and local custody master material.
/.supa-vault/
/.supa-secrets/

# Non-destructive local Git recovery; original .git remains preserved.
/.git-recovery/
# Additional local credentials/custody formats must never enter version control.
*.pem
*.key
id.json
*keypair*.json
/.agents/
/.codex/
/.aws/
*.p12
*.pfx

# Local persistence and backup material; SQL migrations remain eligible.
*.db
*.sqlite
*.sqlite3
*.dump
*.backup
*.sql.gz
/pgdata/
/postgres-data/

# Local frontend dependencies, build output and private browser sessions.
/web/node_modules/
/web/.next/
/web/out/
/web/test-results/
/web/playwright-report/
*.tsbuildinfo
/web/.browser-profile/

/note.txt
